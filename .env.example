# SpendSense Environment Variables
# Copy this file to .env and fill in your actual values
# .env is added to .gitignore and will NOT be pushed to GitHub

# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# Google Sheets Webhook
SHEETS_WEBHOOK_URL=your_google_apps_script_webhook_url_here

# Optional: Google OAuth Configuration (if using Google Sign-In for Sheets)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Optional: Android Keystore for signing APKs
ANDROID_KEYSTORE_PATH=path_to_your_keystore.jks
ANDROID_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_KEY_ALIAS=your_key_alias
ANDROID_KEY_PASSWORD=your_key_password
